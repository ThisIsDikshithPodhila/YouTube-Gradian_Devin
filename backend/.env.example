GUARDIAN_ENVIRONMENT=development
GUARDIAN_DATABASE_URL=postgresql+asyncpg://guardian:guardian@localhost:5432/guardian
GUARDIAN_JWT_SECRET=replace-with-a-random-32-byte-secret
GUARDIAN_ACCESS_MINUTES=15
GUARDIAN_REFRESH_DAYS=30
GUARDIAN_POLICY_KEY_ID=guardian-prod-2025-01
# Generate a local key without committing it:
# python -c 'import base64; from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives.serialization import Encoding, NoEncryption, PrivateFormat; key=Ed25519PrivateKey.generate(); print(base64.b64encode(key.private_bytes(Encoding.Raw, PrivateFormat.Raw, NoEncryption())).decode())'
GUARDIAN_POLICY_PRIVATE_KEY=generated-base64-32-byte-ed25519-private-key
GUARDIAN_POLICY_TRUSTED_PUBLIC_KEYS={"guardian-prod-2025-01":"base64-public-key"}
GUARDIAN_HEALTH_STALE_MINUTES=15
